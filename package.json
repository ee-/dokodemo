{
  "name": "dokodemo",
  "version": "1.0.0",
  "private": true,
  "description": "A single-Worker Scramjet and Wisp browsing proxy proof of concept",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && wrangler dev",
    "build": "npm run assets && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run assets && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/handler.mjs"
  },
  "dependencies": {
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "wisp-worker": "https://codeload.github.com/alpgul/worker-wisp-server/tar.gz/c226c6547377fc1b2cfd6428f9e27a00442618f4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  }
}
